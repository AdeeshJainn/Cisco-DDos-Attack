{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArgusContracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenario_header": {
      "$ref": "#/$defs/ScenarioHeader"
    },
    "metric_record": {
      "$ref": "#/$defs/MetricRecord"
    },
    "net_record": {
      "$ref": "#/$defs/NetRecord"
    },
    "log_record": {
      "$ref": "#/$defs/LogRecord"
    },
    "trace_record": {
      "$ref": "#/$defs/TraceRecord"
    },
    "calendar_record": {
      "$ref": "#/$defs/CalendarRecord"
    },
    "deploy_record": {
      "$ref": "#/$defs/DeployRecord"
    },
    "ground_truth_labels": {
      "$ref": "#/$defs/GroundTruthLabels"
    },
    "decomp_frame": {
      "$ref": "#/$defs/DecompFrame"
    },
    "incident": {
      "$ref": "#/$defs/Incident"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "rca_result": {
      "$ref": "#/$defs/RcaResult"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "rollback": {
      "$ref": "#/$defs/Rollback"
    },
    "clock_payload": {
      "$ref": "#/$defs/ClockPayload"
    },
    "approval_request": {
      "$ref": "#/$defs/ApprovalRequestPayload"
    },
    "mttr_record": {
      "$ref": "#/$defs/MttrRecord"
    },
    "ws_envelope": {
      "$ref": "#/$defs/WsEnvelope"
    }
  },
  "$defs": {
    "Action": {
      "properties": {
        "type": {
          "const": "action",
          "default": "action",
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "rung": {
          "$ref": "#/$defs/ActionRung"
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        },
        "blast_radius": {
          "$ref": "#/$defs/BlastRadius"
        },
        "trigger": {
          "type": "string"
        },
        "expected_effect": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "action_id",
        "decision_id",
        "ts",
        "rung",
        "target",
        "blast_radius",
        "trigger",
        "expected_effect"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionRung": {
      "enum": [
        "observe",
        "rate_limit",
        "throttle",
        "isolate",
        "scale_out",
        "pre_scale",
        "restart",
        "reroute"
      ],
      "title": "ActionRung",
      "type": "string"
    },
    "ActionTarget": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "selector": {
          "type": "string"
        },
        "est_traffic_pct": {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "selector",
        "est_traffic_pct"
      ],
      "title": "ActionTarget",
      "type": "object"
    },
    "AlternateOrigin": {
      "properties": {
        "service": {
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "service",
        "score"
      ],
      "title": "AlternateOrigin",
      "type": "object"
    },
    "ApprovalRequestPayload": {
      "properties": {
        "type": {
          "const": "approval_request",
          "default": "approval_request",
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "proposed_action": {
          "$ref": "#/$defs/Action"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "decision_id",
        "proposed_action",
        "timeout_s"
      ],
      "title": "ApprovalRequestPayload",
      "type": "object"
    },
    "BlastRadius": {
      "properties": {
        "protected_cohorts_touched": {
          "minimum": 0,
          "type": "integer"
        },
        "max_pct_allowed": {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        "gates_passed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "protected_cohorts_touched",
        "max_pct_allowed",
        "gates_passed"
      ],
      "title": "BlastRadius",
      "type": "object"
    },
    "CalendarPhase": {
      "enum": [
        "announce",
        "ramp",
        "start",
        "peak",
        "end"
      ],
      "title": "CalendarPhase",
      "type": "string"
    },
    "CalendarRecord": {
      "properties": {
        "kind": {
          "const": "calendar",
          "default": "calendar",
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "event_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/CalendarPhase"
        },
        "expected_multiplier": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "affects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "ts",
        "event_id",
        "title",
        "phase",
        "expected_multiplier",
        "affects"
      ],
      "title": "CalendarRecord",
      "type": "object"
    },
    "CauseClass": {
      "description": "RCA cause classes; expected surges never reach RCA.",
      "enum": [
        "attack",
        "operational_fault",
        "code_fault",
        "combination"
      ],
      "title": "CauseClass",
      "type": "string"
    },
    "ClassProbability": {
      "properties": {
        "class": {
          "$ref": "#/$defs/VerdictClass"
        },
        "p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "class",
        "p"
      ],
      "title": "ClassProbability",
      "type": "object"
    },
    "ClockPayload": {
      "properties": {
        "type": {
          "const": "clock",
          "default": "clock",
          "type": "string"
        },
        "speed": {
          "enum": [
            1,
            10,
            60
          ],
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ClockState"
        },
        "sim_ts": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "speed",
        "state",
        "sim_ts"
      ],
      "title": "ClockPayload",
      "type": "object"
    },
    "ClockState": {
      "enum": [
        "playing",
        "paused",
        "ended",
        "loading"
      ],
      "title": "ClockState",
      "type": "string"
    },
    "CodeFaultFinding": {
      "properties": {
        "commit": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "function": {
          "type": "string"
        },
        "config_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanism": {
          "type": "string"
        },
        "proposed_fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedFix"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "commit",
        "file",
        "line",
        "function",
        "config_value",
        "mechanism",
        "proposed_fix"
      ],
      "title": "CodeFaultFinding",
      "type": "object"
    },
    "CodeFaultLabel": {
      "properties": {
        "commit": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "mechanism": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "file",
        "line",
        "mechanism"
      ],
      "title": "CodeFaultLabel",
      "type": "object"
    },
    "Cure": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/CureKind"
        },
        "justification": {
          "type": "string"
        },
        "interim_infra_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "justification",
        "interim_infra_action"
      ],
      "title": "Cure",
      "type": "object"
    },
    "CureKind": {
      "enum": [
        "code_fix",
        "infra_action"
      ],
      "title": "CureKind",
      "type": "string"
    },
    "Decision": {
      "properties": {
        "type": {
          "const": "decision",
          "default": "decision",
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "incident_id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "decision": {
          "$ref": "#/$defs/DecisionKind"
        },
        "reason": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "human_gate": {
          "$ref": "#/$defs/HumanGate"
        }
      },
      "required": [
        "type",
        "decision_id",
        "incident_id",
        "ts",
        "decision",
        "reason",
        "evidence_ref",
        "confidence",
        "human_gate"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "suppress",
        "alert",
        "act"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "DecompFrame": {
      "description": "Observed volume split into base + event + residual vs the expected band.",
      "properties": {
        "type": {
          "const": "decomp",
          "default": "decomp",
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "service": {
          "type": "string"
        },
        "signal": {
          "$ref": "#/$defs/MetricName"
        },
        "observed": {
          "type": "number"
        },
        "explained_base": {
          "type": "number"
        },
        "explained_event": {
          "type": "number"
        },
        "residual": {
          "type": "number"
        },
        "band": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        "residual_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "ts",
        "service",
        "signal",
        "observed",
        "explained_base",
        "explained_event",
        "residual",
        "band",
        "residual_score"
      ],
      "title": "DecompFrame",
      "type": "object"
    },
    "DeployRecord": {
      "properties": {
        "kind": {
          "const": "deploy",
          "default": "deploy",
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "service": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ts",
        "service",
        "commit",
        "author",
        "files",
        "summary"
      ],
      "title": "DeployRecord",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "up",
        "down"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EvidenceItem": {
      "description": "One scored reason line: a feature, where it sits vs baseline, and why\nthat matters for the verdict.",
      "properties": {
        "feature": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "baseline": {
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "feature",
        "value",
        "baseline",
        "direction",
        "note"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "GroundTruthIncident": {
      "properties": {
        "gt_id": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/IncidentClass"
        },
        "sub_type": {
          "type": "string"
        },
        "window": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        "origin_service": {
          "type": "string"
        },
        "inside_event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "correct_decision": {
          "$ref": "#/$defs/DecisionKind"
        },
        "reason_category": {
          "$ref": "#/$defs/ReasonCategory"
        },
        "code_fault": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeFaultLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "gt_id",
        "class",
        "sub_type",
        "window",
        "origin_service",
        "inside_event",
        "correct_decision",
        "reason_category",
        "code_fault"
      ],
      "title": "GroundTruthIncident",
      "type": "object"
    },
    "GroundTruthLabels": {
      "description": "Scoring-side ground truth; the argus runtime must never read this\n(labels-isolation lint, invariant I7).",
      "properties": {
        "contract": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "incidents": {
          "items": {
            "$ref": "#/$defs/GroundTruthIncident"
          },
          "type": "array"
        },
        "timestep_labels_file": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "seed",
        "incidents",
        "timestep_labels_file"
      ],
      "title": "GroundTruthLabels",
      "type": "object"
    },
    "HumanGate": {
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approved_ts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "required",
        "approved_by",
        "approved_ts"
      ],
      "title": "HumanGate",
      "type": "object"
    },
    "Incident": {
      "properties": {
        "type": {
          "const": "incident",
          "default": "incident",
          "type": "string"
        },
        "incident_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/IncidentStatus"
        },
        "first_ts": {
          "type": "number"
        },
        "last_ts": {
          "type": "number"
        },
        "symptoms": {
          "items": {
            "$ref": "#/$defs/Symptom"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "type",
        "incident_id",
        "status",
        "first_ts",
        "last_ts",
        "symptoms"
      ],
      "title": "Incident",
      "type": "object"
    },
    "IncidentClass": {
      "description": "Ground-truth incident class: verdict classes plus the combination marker.\n\n``expected_surge`` entries exist so suppress decisions are scorable\nagainst a labeled window.",
      "enum": [
        "expected_surge",
        "attack",
        "operational_fault",
        "code_fault",
        "combination"
      ],
      "title": "IncidentClass",
      "type": "string"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "updated",
        "resolved"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "LogRecord": {
      "properties": {
        "kind": {
          "const": "log",
          "default": "log",
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "service": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ts",
        "service",
        "level",
        "template_id",
        "msg",
        "count"
      ],
      "title": "LogRecord",
      "type": "object"
    },
    "MetricName": {
      "description": "Per-service metric signals every scenario emits at each tick.",
      "enum": [
        "rps",
        "err_rate",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "cpu_pct",
        "mem_pct",
        "conn_active",
        "queue_depth"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricRecord": {
      "properties": {
        "kind": {
          "const": "metric",
          "default": "metric",
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "service": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/MetricName"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "ts",
        "service",
        "name",
        "value"
      ],
      "title": "MetricRecord",
      "type": "object"
    },
    "MttrRecord": {
      "description": "The hours→seconds claim, per incident, with the timestamps that prove it.",
      "properties": {
        "type": {
          "const": "mttr",
          "default": "mttr",
          "type": "string"
        },
        "incident_id": {
          "type": "string"
        },
        "onset_ts": {
          "type": "number"
        },
        "detected_ts": {
          "type": "number"
        },
        "root_caused_ts": {
          "type": "number"
        },
        "mitigated_ts": {
          "type": "number"
        },
        "verified_ts": {
          "type": "number"
        },
        "manual_baseline_s": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "autonomous_s": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "incident_id",
        "onset_ts",
        "detected_ts",
        "root_caused_ts",
        "mitigated_ts",
        "verified_ts",
        "manual_baseline_s",
        "autonomous_s"
      ],
      "title": "MttrRecord",
      "type": "object"
    },
    "NetRecord": {
      "description": "Load-invariant network behavior features — the volume-vs-behavior axis.",
      "properties": {
        "kind": {
          "const": "net",
          "default": "net",
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "service": {
          "type": "string"
        },
        "uniq_ip_entropy": {
          "minimum": 0,
          "type": "number"
        },
        "syn_ack_ratio": {
          "minimum": 0,
          "type": "number"
        },
        "auth_fail_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "ja3_novelty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "geo_top1_share": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "ts",
        "service",
        "uniq_ip_entropy",
        "syn_ack_ratio",
        "auth_fail_ratio",
        "ja3_novelty",
        "geo_top1_share"
      ],
      "title": "NetRecord",
      "type": "object"
    },
    "ProposedFix": {
      "properties": {
        "summary": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "diff"
      ],
      "title": "ProposedFix",
      "type": "object"
    },
    "RcaOrigin": {
      "description": "Exactly one origin; alternates are ranked, never co-equal (invariant I8).",
      "properties": {
        "service": {
          "type": "string"
        },
        "onset_ts": {
          "type": "number"
        },
        "alternates": {
          "items": {
            "$ref": "#/$defs/AlternateOrigin"
          },
          "type": "array"
        }
      },
      "required": [
        "service",
        "onset_ts",
        "alternates"
      ],
      "title": "RcaOrigin",
      "type": "object"
    },
    "RcaResult": {
      "properties": {
        "type": {
          "const": "rca",
          "default": "rca",
          "type": "string"
        },
        "incident_id": {
          "type": "string"
        },
        "origin": {
